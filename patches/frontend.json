     "new": "  <script>\n      // Reveal gate: the window may be mapped before the page has finished loading, so keep the document\n      // (practically) invisible until the route component is mounted, its first state has arrived, the fonts\n      // and CSS images that the first frame uses are loaded, and one frame has been laid out. Everything here\n      // is timer/promise driven: requestAnimationFrame does not run while a window is unmapped.\n      // Contract: no Rust cooperation needed; a hard timeout always reveals. Toast is an overlay and is exempt.\n      (function () {\n        var de = document.documentElement;\n        if (location.hash.indexOf('#/toast') === 0) return;\n        de.setAttribute('data-ww-gate', '');\n        // Keep the native window hidden until this gate finishes, including slow locale fonts.\n        try { var I = window.__TAURI_INTERNALS__; if (I) I.invoke('window_gate').catch(function () {}); } catch (e) {}\n        var t0 = performance.now(), MAX = 4000, done = false;\n        function reveal(why) {\n          if (done) return;\n          done = true;\n          de.removeAttribute('data-ww-gate');\n          de.setAttribute('data-ww-ready', why + '@' + Math.round(performance.now() - t0));\n          window.__wwReady = why;\n          // Optional hook for a future Rust \"show after ready\" (docs/ui-flash-and-fonts.md); rejects harmlessly today.\n          try { var I = window.__TAURI_INTERNALS__; if (I) I.invoke('window_ready', { reason: why }).catch(function () {}); } catch (e) {}\n        }\n        setTimeout(function () { reveal('timeout'); }, MAX);\n\n        // Same locale -> font mapping as the app's .locale-* classes (index CSS).\n        var FAMS = { jp: ['GenSenRoundedJP-M', 'GenSenRoundedJP-B'], zh: ['975MaruSC', '975MaruSC-Bold'],\n          tw: ['SourceHanSansCN-Medium', 'SourceHanSansCN-Bold'], kr: ['NanumGothic-Bold', 'NanumGothic-ExtraBold'],\n          th: ['Prompt-Medium', 'Prompt-Bold'] };\n        var loc = 'en'